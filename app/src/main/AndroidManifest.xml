<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.demo.foodorderanddeliveryappkotlin">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodOrderAndDeliveryAppKotlin">
        <activity
            android:name=".AuthActivity"
            android:exported="true" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Activities in activities package -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true" />
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true" />
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="true" />
        <activity
            android:name=".activities.RestaurantListActivity"
            android:exported="true" />
        <activity
            android:name=".activities.RestaurantMenuActivity"
            android:exported="true" />
        <activity
            android:name=".activities.MyOrdersActivity"
            android:exported="true" />
        <activity
            android:name=".activities.PlaceYourOrderActivity"
            android:exported="true" />
        <activity
            android:name=".activities.OrderConfirmationActivity"
            android:exported="true" />
        <activity
            android:name=".activities.TrackOrderActivity"
            android:exported="true" />
        <activity
            android:name=".activities.CartActivity"
            android:exported="true" />
        <activity
            android:name=".activities.FavoritesActivity"
            android:exported="true" />
        <activity
            android:name=".activities.SuccessOrderActivity"
            android:exported="true" />
    </application>

</manifest>